# Inside the same HTTPS server block as GLPI. Preserve your existing GLPI rules.
location = /notificationbell-live/events {
    proxy_pass http://127.0.0.1:8091/events;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Origin $http_origin;
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 180s;
    # Short-lived capabilities must never enter access logs.
    access_log off;
}
